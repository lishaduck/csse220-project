@startuml
class GameApp
class Battle
class BattleView
class PlayerView
class GameModel
abstract class Ship
class PlayerShip
class EnemyShip
class Dimension2D
enum HorizontalDirection

GameApp --> GameModel
GameApp --> Battle
Battle *-- BattleView
Battle --> GameModel
Battle ..> HorizontalDirection
GameModel *-- PlayerShip
GameModel --> Dimension2D
Ship <|-- PlayerShip
Ship <|-- EnemyShip
Ship --> Dimension2D
PlayerShip ..> HorizontalDirection
BattleView ..> GameModel
BattleView ..> Dimension2D
BattleView *-- PlayerView
PlayerView ..> PlayerShip
@enduml
