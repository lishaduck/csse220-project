@startuml
class GameApp
class Battle
class BattleView
class PlayerView
class GameModel
abstract class Ship
class PlayerShip
class EnemyShip
class Dimension2D
class PlayerInput <<record>>
enum HorizontalDirection

GameApp --> GameModel
GameApp --> Battle
Battle *-- BattleView
Battle --> GameModel
Battle ..> HorizontalDirection
Battle ..> PlayerInput
PlayerInput --> HorizontalDirection
GameModel ..> PlayerInput
GameModel *-- PlayerShip
GameModel --> Dimension2D : playfield
Ship <|-- PlayerShip
Ship <|-- EnemyShip
Ship --> Dimension2D : size
Ship ..> Dimension2D : supplied bounds
PlayerShip ..> HorizontalDirection
BattleView ..> GameModel
BattleView ..> Dimension2D
BattleView *-- PlayerView
PlayerView ..> PlayerShip
@enduml
